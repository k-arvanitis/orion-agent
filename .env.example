# Order database (Olist). Local container from docker-compose by default
# (make db && make load-data). Point at Supabase/RDS/your own Postgres in production.
DATABASE_URL=postgresql://orion:orion@localhost:5439/orion

# Support CRM database. Defaults to local SQLite when omitted.
# Point this at Supabase/PostgreSQL in deployed environments.
SUPPORT_DATABASE_URL=sqlite:///data/orion_support.db

# Qdrant — local container from docker-compose by default (make qdrant).
# For Qdrant Cloud set the cluster URL and its API key instead.
QDRANT_URL=http://localhost:6337
QDRANT_API_KEY=

# Chat LLM — OpenRouter is preferred when its key is present.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_REQUEST_TIMEOUT_S=60
# Optional: pin requests to one OpenRouter backend, e.g. DeepInfra.
# OPENROUTER_PROVIDER_PIN=DeepInfra

# Groq — used by voice transcription and available as a chat fallback.
GROQ_API_KEY=your-groq-api-key

# LangSmith
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=orion-agent

# ElevenLabs (voice mode — text-to-speech)
ELEVENLABS_API_KEY=sk_...

# Optional — Slack incoming webhook, posted to when escalate_to_human fires.
# Without it, escalation still works, it just doesn't notify anyone.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional — override defaults shown below
# AGENT_MODEL=qwen/qwen3-235b-a22b-2507
# DENSE_MODEL=BAAI/bge-small-en-v1.5
# SPARSE_MODEL=Qdrant/bm25
# QDRANT_COLLECTION=orion-policies
# VOICE_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# VOICE_TTS_MODEL=eleven_turbo_v2_5
# VOICE_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
